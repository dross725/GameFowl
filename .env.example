# SmartWagers — Production Environment Variables
# Copy this file to .env and fill in the values for your server.
# The .env file is loaded automatically by settings.py at startup.

# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key

# Set to False in production to hide stack traces from users
DJANGO_DEBUG=False

# Comma-separated list of hostnames/IPs the server responds to.
# Must include the server's LAN IP so browsers can reach it.
# Example: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<SERVER-LAN-IP>

# Comma-separated list of trusted origins for CSRF protection.
# Include http://<SERVER-LAN-IP>:8080 (or :80 if using port 80).
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.10:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://<SERVER-LAN-IP>:8080

# URL teller PCs open in Chrome (used by local_print_agent/start_teller.bat).
SMARTWAGERS_SERVER_URL=http://<SERVER-LAN-IP>:8080

# Set to True to require that tellers always print a receipt before a bet is confirmed.
WAGER_RECEIPT_PRINTING_ENABLED=True

# ---------------------------------------------------------------------------
# Master lock (offline monthly activation)
# ---------------------------------------------------------------------------
# Required in production (DJANGO_DEBUG=False defaults MASTER_LOCK_REQUIRED=True).
MASTER_LOCK_REQUIRED=True

# Separate HMAC signing secret (NOT the Django SECRET_KEY, NOT the master password).
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
MASTER_LOCK_SIGNING_KEY=replace-me-with-a-random-signing-key

# Django password hash of the master lock key (never store the plaintext key).
# Generate with: python manage.py hash_master_lock_key
MASTER_LOCK_PASSWORD_HASH=

# Signed state file path (Windows production default shown).
MASTER_LOCK_STATE_PATH=C:\SmartWagers\data\master_lock.state
