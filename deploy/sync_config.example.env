# Copy to deploy/sync_config.env and edit for your environment.
# sync_config.env is gitignored — never commit secrets or host details.

# Transport: scp | rsync | copy | package
#   scp   — push changed files over SSH (works with Windows OpenSSH)
#   rsync — faster over SSH when rsync is available on both sides
#   copy  — copy into a local/UNC path (same PC or WSL /mnt/c/... on the server)
#   package — create an offline USB release (also set PACKAGE_OUTPUT_ROOT)
DEPLOY_METHOD=scp

# Optional default USB release output. A timestamped folder is created beneath it.
# PACKAGE_OUTPUT_ROOT=E:\SmartWagersReleases

# Remote SSH target (scp/rsync methods)
DEPLOY_HOST=192.168.1.10
DEPLOY_USER=Administrator
DEPLOY_PORT=22

# Project root on the production server
DEPLOY_REMOTE_ROOT=C:/SmartWagers/GameFowl

# Local destination for copy method (WSL example: /mnt/c/SmartWagers/GameFowl)
# DEPLOY_LOCAL_ROOT=/mnt/c/SmartWagers/GameFowl

# Run migrate/collectstatic/restart on the server after a successful sync (scp/rsync)
DEPLOY_REMOTE_APPLY=true

# Optional extra SSH options (single line), e.g. -i C:/Users/you/.ssh/id_rsa
# DEPLOY_SSH_OPTIONS=-o StrictHostKeyChecking=accept-new
