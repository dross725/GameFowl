# Dependencies and local Expo state
node_modules/
.expo/

# Native projects are generated by `npx expo prebuild` — never ship to Windows.
# Their Gradle/CMake paths exceed the classic Windows MAX_PATH (~260 chars).
android/
ios/

# Local build caches (if prebuild output is kept outside the ignored folders)
**/.gradle/
**/.cxx/
**/build/

# Release APK lives in dist/ for Admin → Print Agent downloads (not committed).
dist/*
!dist/README.md

*.jks
*.keystore
.env
.DS_Store
*.log
